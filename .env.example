# openTCS Web API base URL (v1)
# Default points to local openTCS instance
OPENTCS_BASE_URL=http://localhost:55200/v1

# Battery check interval in milliseconds
# Minimum: 1000ms. Default: 10000ms (10 seconds)
POLL_INTERVAL_MS=10000

# HTTP port this service listens on
PORT=3500

# Path to persisted JSON config file
# Created automatically with defaults if it does not exist
CONFIG_FILE=./config.json

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info
